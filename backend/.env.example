# HireShield Backend Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:8000

# Authentication & Security
JWT_SECRET=hireshield-super-secret-jwt-key-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7

# Optional Google OAuth Client ID (for Google Sign In)
GOOGLE_CLIENT_ID=

# Optional LLM Entity Extraction API Keys (rule-based fallback runs automatically if unset)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional Google Safe Browsing / WHOIS API Keys
GOOGLE_SAFE_BROWSING_KEY=
WHOIS_API_KEY=

# Database URL
DATABASE_URL=sqlite:///./hireshield.db
